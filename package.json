{
  "name": "minmsn",
  "version": "0.2.0",
  "description": "MSN-liknande klient för Facebook Messenger",
  "main": "src/main.js",
  "author": "Mattias",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "dist": "electron-builder --win portable zip --x64 --publish never",
    "demo": "electron . --demo"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "se.mattias.minmsn",
    "productName": "MinMSN",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ]
    },
    "portable": {
      "artifactName": "MinMSN-${version}.exe"
    }
  }
}
